local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local Stats = game:GetService("Stats")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ParryRemote, FireServerFunc = nil, nil
local RemoteArgs = {nil, nil, nil, nil, nil, nil, nil}
local RemoteHooked = false

local Config = {
	AutoSpam = false,
	TriggerBot = false,
	ManualSpamBtn = false,
	SpamActive = false,
	TriggerBotFiring = false,
	SpamActiveInternal = false,
}

local CurveMethod = "camera"
local LastSpamTick = 0 
local LastTriggerTick = 0 
local LastSpamTick2 = 0
local SpamDelay = 1 / (10 * 87)

local Detections = {
	infinity = false,
	deathslash = false,
	timehole = false,
	slashesoffury = false,
}

local AbilityActive = {
	Infinity = false,
	DeathSlash = false,
	TimeHole = false,
	SlashesOfFury = false,
}

local SOF_ParryCount = 0 
local SOF_MaxCount = 36 
local SOF_Delay = 0.05 

local Alive = workspace:FindFirstChild("Alive")

local function IsAlive()
	return workspace:FindFirstChild("Alive") ~= nil 
end

RunService.Heartbeat:Connect(function()
	if not Alive or not Alive.Parent then
		Alive = workspace:FindFirstChild("Alive")
	end
end)

local function GetCurveCFrame()
	local currentCamera = workspace.CurrentCamera
	local character = LocalPlayer.Character
	local HumanoidRootPart = character and character:FindFirstChild("HumanoidRootPart") 
	
	if not HumanoidRootPart then
		return currentCamera.CFrame
	end
	
	local highestDot = -math.huge
	local targetPos = nil
	
	if Alive then
		for _, playerChar in pairs(Alive:GetChildren()) do
			if (playerChar ~= character) and playerChar:FindFirstChild("HumanoidRootPart") then
				local dir = (playerChar.HumanoidRootPart.Position - currentCamera.CFrame.Position).Unit
				local dot = currentCamera.CFrame.LookVector:Dot(dir)
				if dot > highestDot then
					highestDot = dot
					targetPos = playerChar.HumanoidRootPart.Position
				end
			end
		end
	end
	
	targetPos = targetPos or (HumanoidRootPart.Position + (currentCamera.CFrame.LookVector * 1000)) 
	local dirToTarget = (targetPos - HumanoidRootPart.Position).Unit
	
	if CurveMethod == "dot" then
		return CFrame.lookAt(HumanoidRootPart.Position, dirToTarget + Vector3.new(0, 1.75, 0))
	elseif CurveMethod == "backwards" then
		return CFrame.new(HumanoidRootPart.Position, HumanoidRootPart.Position + (-dirToTarget * 1000))
	elseif CurveMethod == "slow" then
		return CFrame.new(HumanoidRootPart.Position, HumanoidRootPart.Position + Vector3.new(0, -350, 0))
	else
		return currentCamera.CFrame
	end
end

local function GetBall()
	local ballsFolder = workspace:FindFirstChild("Balls")
	if ballsFolder then
		for _, ball in pairs(ballsFolder:GetChildren()) do
			if ball:IsA("BasePart") and ball:GetAttribute("realBall") then
				return ball
			end
		end
		local firstChild = ballsFolder:GetChildren()[1]
		if firstChild and firstChild:IsA("BasePart") then
			return firstChild
		end
	end
	
	for _, obj in ipairs(workspace:GetChildren()) do
		if obj:IsA("BasePart") and obj.Name:lower():find("ball") then
			return obj
		end
	end
	
	for _, folderName in ipairs({"Lobby", "Training", "Practice", "Map", "Game"}) do
		local f = workspace:FindFirstChild(folderName)
		if f then
			for _, obj in ipairs(f:GetDescendants()) do
				if obj:IsA("BasePart") and obj.Name:lower():find("ball") then
					return obj
				end
			end
		end
	end
	return nil
end

local function GetClosestPlayer()
	if not LocalPlayer.Character or not LocalPlayer.Character.PrimaryPart then return nil end
	local shortestDist = math.huge
	local closestPlayer = nil
	
	if Alive then
		for _, p in pairs(Alive:GetChildren()) do
			if p ~= LocalPlayer.Character and p.PrimaryPart then
				local dist = (LocalPlayer.Character.PrimaryPart.Position - p.PrimaryPart.Position).Magnitude
				if dist < shortestDist then
					shortestDist = dist
					closestPlayer = p
				end
			end
		end
	end
	return closestPlayer
end

local PlayerScreenPositions = {}
local LastScreenPosUpdate = 0 

local function AttemptParry()
	if not (ParryRemote and FireServerFunc) then return end
	
	local currentCamera = workspace.CurrentCamera
	local char = LocalPlayer.Character
	if not char then return end
	
	local t = tick()
	if (t - LastScreenPosUpdate) > 0.1 then
		PlayerScreenPositions = {}
		if Alive then
			for _, p in ipairs(Alive:GetChildren()) do
				if p ~= char and p.PrimaryPart then
					local pos, onScreen = currentCamera:WorldToScreenPoint(p.PrimaryPart.Position)
					if onScreen then
						PlayerScreenPositions[tostring(p)] = pos
					end
				end
			end
		end
		LastScreenPosUpdate = t
	end
	
	local vpSize = currentCamera.ViewportSize
	local curveCFrame = GetCurveCFrame()
	
	RemoteArgs[3] = curveCFrame.LookVector
	RemoteArgs[4] = curveCFrame
	RemoteArgs[5] = PlayerScreenPositions
	RemoteArgs[6] = {vpSize.X / 2, vpSize.Y / 2}
	
	pcall(function()
		FireServerFunc(ParryRemote, unpack(RemoteArgs))
	end)
end

pcall(function()
	ReplicatedStorage.Remotes.DeathBall.OnClientEvent:Connect(function(_, state)
		AbilityActive.DeathSlash = state or false 
	end)
	ReplicatedStorage.Remotes.InfinityBall.OnClientEvent:Connect(function(_, state)
		AbilityActive.Infinity = state or false 
	end)
	
	local NetStore = ReplicatedStorage.Packages._Index["sleitnick_net@0.1.0"].net
	
	NetStore["RE/TimeHoleActivate"].OnClientEvent:Connect(function(plr)
		if plr == LocalPlayer or (plr and plr.Name == LocalPlayer.Name) then
			AbilityActive.TimeHole = true
		end
	end)
	NetStore["RE/TimeHoleDeactivate"].OnClientEvent:Connect(function()
		AbilityActive.TimeHole = false
	end)
	
	NetStore["RE/SlashesOfFuryActivate"].OnClientEvent:Connect(function(plr)
		if plr == LocalPlayer or (plr and plr.Name == LocalPlayer.Name) then
			AbilityActive.SlashesOfFury = true
			SOF_ParryCount = 0 
		end
	end)
	NetStore["RE/SlashesOfFuryCatch"].OnClientEvent:Connect(function()
		task.spawn(function()
			while AbilityActive.SlashesOfFury and (SOF_ParryCount < SOF_MaxCount) do
				if Detections.slashesoffury then
					AttemptParry()
					task.wait(SOF_Delay)
				else
					break
				end
			end
		end)
	end)
	NetStore["RE/SlashesOfFuryEnd"].OnClientEvent:Connect(function()
		AbilityActive.SlashesOfFury = false
		SOF_ParryCount = 0 
	end)
	NetStore["RE/SlashesOfFuryParry"].OnClientEvent:Connect(function()
		SOF_ParryCount = SOF_ParryCount + 1
	end)
end)

local AutoSpamConnection = nil

local function StartAutoSpam()
	Config.SpamActiveInternal = false
	if AutoSpamConnection then AutoSpamConnection:Disconnect() end
	
	AutoSpamConnection = RunService.PreSimulation:Connect(function()
		if not Config.AutoSpam or not IsAlive() then return end
		
		local char = LocalPlayer.Character
		if not char or not char.PrimaryPart then return end
		if char.Parent ~= workspace:FindFirstChild("Alive") then return end
		if AbilityActive.SlashesOfFury then return end
		
		local ball = GetBall()
		if not ball then return end
		
		local zoomies = ball:FindFirstChild("zoomies")
		if not zoomies then return end
		if ball:GetAttribute("target") ~= LocalPlayer.Name then return end
		
		local closestPlayer = GetClosestPlayer()
		if not closestPlayer or not closestPlayer.PrimaryPart then return end
		
		local ping = math.clamp(Stats.Network.ServerStatsItem["Data Ping"]:GetValue() / 10, 1, 16)
		local velocityMag = ball.AssemblyLinearVelocity.Magnitude
		local distThreshold = ping + math.min(velocityMag / 6, 255) 
		
		local distToPlayer = LocalPlayer:DistanceFromCharacter(closestPlayer.PrimaryPart.Position)
		local distToBall = LocalPlayer:DistanceFromCharacter(ball.Position)
		
		if distToPlayer > distThreshold or distToBall > distThreshold then return end
		if Detections.infinity and AbilityActive.Infinity then return end
		if Detections.deathslash and AbilityActive.DeathSlash then return end
		if Detections.timehole and AbilityActive.TimeHole then return end
		if char:GetAttribute("Pulsed") then return end
		
		local t = tick()
		if (t - LastSpamTick2) >= SpamDelay then
			LastSpamTick2 = t
			AttemptParry()
		end
	end)
end

local function StopAutoSpam()
	Config.SpamActiveInternal = false
	if AutoSpamConnection then
		AutoSpamConnection:Disconnect()
		AutoSpamConnection = nil
	end
end

local function OnCharacterAdded(char)
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then return end
	
	hum.Died:Connect(function()
		Config.SpamActiveInternal = false
		Config.SpamActive = false
		Config.TriggerBotFiring = false
	end)
end

LocalPlayer.CharacterAdded:Connect(function(char)
	task.spawn(function() OnCharacterAdded(char) end)
end)

if LocalPlayer.Character then
	task.spawn(function() OnCharacterAdded(LocalPlayer.Character) end)
end

local CurrentTargetBall = nil
local LastBallCheckTick = 0

RunService.Heartbeat:Connect(function()
	local t = tick()
	
	local char = LocalPlayer.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart") 
	if not hrp then return end
	
	if (t - LastBallCheckTick) > 1 then
		CurrentTargetBall = GetBall()
		LastBallCheckTick = t
	end
	
	local ball = CurrentTargetBall
	local isAlive = IsAlive()
	
	if not isAlive then
		Config.SpamActiveInternal = false
		Config.TriggerBotFiring = false
	end
	
	if ball and ball:IsA("BasePart") then
		local ballSpeed = ball.Velocity.Magnitude
		local dist = (hrp.Position - ball.Position).Magnitude
	
		if Config.TriggerBot and isAlive then
			local dot = (ballSpeed > 1) and (ball.Velocity.Unit:Dot((hrp.Position - ball.Position).Unit) > 0.3) 
			if dot and dist <= 35 then
				if not Config.TriggerBotFiring then Config.TriggerBotFiring = true end
			elseif Config.TriggerBotFiring then
				Config.TriggerBotFiring = false
			end
		end
	else
		if Config.TriggerBotFiring then Config.TriggerBotFiring = false end
	end
	
	if Config.TriggerBot and Config.TriggerBotFiring and ParryRemote and FireServerFunc and isAlive then
		if (t - LastTriggerTick) >= SpamDelay then
			LastTriggerTick = t
			AttemptParry()
		end
	end
	
	if Config.ManualSpamBtn and Config.SpamActive and ParryRemote and FireServerFunc and isAlive then
		if (t - LastSpamTick) >= SpamDelay then
			LastSpamTick = t
			AttemptParry()
		end
	end
end)
